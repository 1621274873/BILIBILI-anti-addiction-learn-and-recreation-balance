{
  "manifest_version": 3,
  "name": "Bili Balance",
  "version": "0.3.1",
  "description": "Local Bilibili study and recreation timers, daily limits, and a reminder after 25 minutes of continuous recreation.",
  "permissions": [
    "storage"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src 'none'; base-uri 'none'"
  },
  "host_permissions": [
    "https://www.bilibili.com/*"
  ],
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Bili Balance",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "assets/icon16.png",
      "32": "assets/icon32.png",
      "48": "assets/icon48.png",
      "128": "assets/icon128.png"
    }
  },
  "icons": {
    "16": "assets/icon16.png",
    "32": "assets/icon32.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.bilibili.com/*"
      ],
      "js": [
        "src/content/playback-clock.js",
        "src/content/panel/styles.js",
        "src/content/panel/view.js",
        "src/content/floating-panel.js",
        "src/content/content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
